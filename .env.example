# ============================================================
# Zelo — variáveis de ambiente
# Copie para .env.local e preencha. Nenhuma delas é obrigatória:
# se ficar vazia, a integração correspondente simplesmente não carrega.
# ============================================================

# URL pública do site. Usada por metadata, canonical, Open Graph,
# robots.txt e sitemap. Sem ela, tudo cai no padrão https://zelopay.com.br
NEXT_PUBLIC_SITE_URL=https://zelopay.com.br

# Libera indexação por mecanismos de busca (robots.txt). Opt-in de
# propósito: vazio/ausente = bloqueado (staging, preview, dev local nunca
# vazam para o Google por esquecimento). Só produção deve setar "true".
# Não é a URL que decide isto — é esta flag, porque a URL de um deploy de
# staging muda a cada preview e não dá pra comparar contra ela de forma
# confiável.
NEXT_PUBLIC_PERMITIR_INDEXACAO=

# Google Analytics 4 — formato G-XXXXXXXXXX
# Crie a propriedade em analytics.google.com e cole o ID de medição aqui.
# Vazio = nenhum script do GA é carregado.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity — ID do projeto em clarity.microsoft.com
# Vazio = nenhum script do Clarity é carregado.
NEXT_PUBLIC_CLARITY_ID=

# Asaas — reservado para a futura integração de cobrança no servidor.
# Não preencher até a integração ser implementada e as credenciais oficiais
# serem fornecidas. Nunca expor esta chave com o prefixo NEXT_PUBLIC_.
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# ------------------------------------------------------------
# Supabase — destino dos leads de /comecar
# ------------------------------------------------------------
# SEM o prefixo NEXT_PUBLIC_ de propósito: com ele, o Next injetaria os
# valores no bundle do navegador e a chave de serviço ficaria pública.
# Estas duas variáveis só existem no servidor.
#
# Enquanto as duas estiverem vazias, /api/lead responde 503 e o formulário
# avisa honestamente que nada foi enviado. Nada quebra.
#
# Onde achar: painel do Supabase > Project Settings > API.
# SUPABASE_URL         = "Project URL"  (https://<ref>.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY = "service_role" — NUNCA a anon, NUNCA no cliente,
#                             NUNCA em repositório. Ela ignora RLS.
#
# Antes de preencher, crie a tabela: ver docs/supabase-leads.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chaves PÚBLICAS do Supabase — usadas pelo navegador para manter a sessão.
# NEXT_PUBLIC_ aqui é correto: a chave publicável respeita o RLS, e é o RLS
# que protege os dados. Não confundir com a service_role acima, que ignora
# o RLS e nunca pode ter este prefixo.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------
# Asaas — subcontas (Fase 6)
# ---------------------------------------------------------------
# Token EXCLUSIVO do webhook. Obrigatório: sem ele o endpoint devolve 503.
# NUNCA reutilize a ASAAS_API_KEY aqui — são segredos de naturezas
# diferentes, e reutilizar um como o outro faz o vazamento de um
# comprometer os dois.
ASAAS_WEBHOOK_TOKEN=

# Id da conta raiz do Zelo no Asaas. O webhook usa este valor para
# distinguir a mensalidade da plataforma das cobranças das subcontas.
ASAAS_PLATFORM_ACCOUNT_ID=

# Chave de cifra das credenciais das subcontas, 32 bytes.
# Gerar com: openssl rand -base64 32
# Perder esta chave torna as credenciais gravadas irrecuperáveis.
ASAAS_CREDENTIALS_KEY=

# ---------------------------------------------------------------
# Cron — geração automática de cobrança recorrente (vercel.json)
# ---------------------------------------------------------------
# Segredo do endpoint /api/cron/gerar-cobrancas. Sem ele, o endpoint
# devolve 503 (mesma disciplina do ASAAS_WEBHOOK_TOKEN: problema do
# servidor, não de quem chamou). Ao configurar CRON_SECRET no projeto
# Vercel, a própria Vercel envia "Authorization: Bearer $CRON_SECRET"
# nos Cron Jobs automaticamente — não precisa configurar nada além
# desta variável.
# Gerar com: openssl rand -base64 32
CRON_SECRET=

# ---------------------------------------------------------------
# E-mail transacional — Resend (Fase 22)
# ---------------------------------------------------------------
# Camada isolada em lib/email/ — nada no resto do sistema importa o
# Resend diretamente, só lib/email/enviar.ts::sendEmail. Sem RESEND_API_KEY
# ou EMAIL_FROM, os e-mails simplesmente não são enviados (status
# "nao_configurado") — nenhuma funcionalidade que não depende de e-mail é
# afetada, e nada finge sucesso.
#
# NUNCA prefixar RESEND_API_KEY com NEXT_PUBLIC_ — isso a exporia no
# bundle do navegador. Ela só pode ser lida em código de servidor.
#
# Onde conseguir: painel do Resend (resend.com) > API Keys.
RESEND_API_KEY=

# Remetente — precisa ser um endereço no domínio verificado no Resend
# (Domains > Add Domain, depois configurar os registros DNS que o próprio
# Resend fornece). Formato aceito: "email@dominio.com" ou
# "Nome <email@dominio.com>".
EMAIL_FROM=

# Opcional — para onde uma resposta do destinatário deveria ir. Se vazio,
# o Resend usa o próprio EMAIL_FROM como reply-to.
EMAIL_REPLY_TO=
